# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
ADMIN_KEY=Secret_Key

# Optional — enables EPC Register data (energy ratings, floor areas)
# Register free at: https://epc.opendatacommunities.org/
EPC_EMAIL=your-email@example.com
EPC_API_KEY=your-epc-api-key-here

# ── Firebase (client-side, required for Auth + Firestore) ──────────────────
# Create a project at https://console.firebase.google.com
#   1. Project Settings → Your apps → Add app → Web
#   2. Copy the firebaseConfig values below
#   3. In the Firebase Console also enable:
#      - Authentication → Sign-in methods → Email/Password and Google
#      - Firestore Database → Create database (production mode)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
